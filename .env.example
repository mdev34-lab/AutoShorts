# Environment Configuration
# Copy this file to .env and fill in your actual values

# API Configuration
API_KEY=your_api_key_here
API_URL=https://gen.pollinations.ai/v1/chat/completions
IMG_URL=https://gen.pollinations.ai/image/

# API Timeouts (seconds)
API_TIMEOUT_TEXT=30
API_TIMEOUT_IMAGE=60
API_TIMEOUT_SEARCH=15
FFPROBE_TIMEOUT=30

# Model Configuration
MODEL_TEXT=nova-fast
MODEL_IMAGE=zimage

# TTS Configuration
# TTS engine: edge (cloud, default) or piper (local neural, offline, pt-BR voice)
# For piper: pip install "autoshorts[piper]"; the voice model downloads once to PIPER_CACHE_DIR
#TTS_ENGINE=edge
#PIPER_VOICE_ID=pt_BR-faber-medium
#PIPER_VOICE_URL=
#PIPER_CACHE_DIR=~/.cache/autoshorts/piper
VOICE=en-US-BrianMultilingualNeural
TTS_RATE=+20%

# Output Settings
OUTPUT_DIR=output
DEFAULT_FONT=src/autoshorts/fonts/BebasNeue-Regular.ttf
SUBTITLE_FONT_SIZE=60

# Background Processing Mode (jumpcut = default, speed = old mode)
BG_MODE=jumpcut
JUMPCUT_SEG_DUR=4.0
BG_SKIP_INTRO=25.0  # Skip first N seconds (intros/logos)

# Video Settings (FPS doesn't affect quality - use resolution for quality)
VIDEO_FPS=24
VIDEO_CODEC=libx264
AUDIO_CODEC=aac
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920

# Video Processing
MIN_VIDEO_DURATION=60
MAX_VIDEO_DURATION=3600
MAX_VIDEO_CUT_DURATION=300
BLUR_RADIUS=10
MAX_ZOOM_VALUE=1.15

# Encoding Settings (quality-first defaults)
ENCODING_PRESET=medium
ENCODING_CRF=18
ENCODING_THREADS=4

# Image Search Settings (used with --images web)
IMAGE_SEARCH_SAFE=on  # off, moderate, on (recommended: on)
# Image providers in preference order. Default is fail-closed: "commons"
# (Wikimedia Commons) only - license verified against a reusable-license
# allowlist, attribution collected, contextual fit required.
# "ddg" (DuckDuckGo) is an explicit opt-in fallback: stock-agency domains
# are blocked and contextual fit is required, but the license stays
# UNVERIFIED - per-image provenance is delivered in image_credits.txt
# next to the video, and unverified entries must be reviewed before
# publishing.
IMAGE_PROVIDERS=commons
# Web photos are used ONLY for broad, generic requests (no names, years, teams,
# models or events; the bundled generic-word list is small) and only after the
# license allowlist, the OCR pixel gate and a local CLIP broad-class check pass.
# Specific requests (people, teams, products, dates, events) fall back to AI
# images: no free check can verify who or what a photo shows.
# ALLOW_UNVERIFIED_IMAGES=1 turns ALL of those gates off (any provider, any
# request, no pixel/subject check). Entries it creates are marked
# unverified_opt_in in their credits record and are never reused without it.
#ALLOW_UNVERIFIED_IMAGES=0
IMAGE_SEARCH_PER_QUERY=5
IMAGE_MIN_WIDTH=720
IMAGE_MIN_HEIGHT=720
TARGET_IMAGE_WIDTH=1080
TARGET_IMAGE_HEIGHT=1920

# Overlay Text Removal (Tesseract + OpenCV inpainting on downloaded images)
# Requires the tesseract binary (apt install tesseract-ocr; + tesseract-ocr-por
# for Portuguese and TEXT_REMOVAL_LANG=por+eng).
IMAGE_TEXT_REMOVAL=on
TEXT_REMOVAL_MIN_CONFIDENCE=60
TEXT_REMOVAL_MAX_COVERAGE=0.35  # above this the image is a text graphic: keep original
TEXT_REMOVAL_INPAINT_RADIUS=4
TEXT_REMOVAL_LANG=eng
# Subject-aware framing for downloaded images (face/saliency detection)
SUBJECT_FRAMING=true
SUBJECT_FILL_ZOOM_THRESHOLD=1.5  # above this zoom mismatch, use blurred-fill instead of cropping
SUBJECT_FILL_BLUR_RADIUS=25

# YouTube Settings
YOUTUBE_MAX_HEIGHT=360
YOUTUBE_FORMAT=bestvideo[height<=360]+bestaudio/best[height<=360]

# Effect Settings
CROSSFADE_TIME=0.5
START_FADE=1.0

# Product videos
#AUTOSHORTS_PRONUNCIATION_FILE=

# Additional Settings
TEMP_DIR_PREFIX=autoshorts_
STROKE_WIDTH=5
SUBTITLE_START_Y_RATIO=0.65
BOTTOM_MARGIN=150
MAX_CHARS_PER_LINE=20
LINE_SPACING=35
COLOR_TEXT=#FFFFFF
COLOR_HIGHLIGHT=#FFFF00
COLOR_STROKE=#000000
SUBTITLE_MODE=simple